+
+/// A direct, allocation-free evaluation of four canonical quotient bits.
+/// Rebuild masks only after the span changes; no per-clause cached state.
+/// This is deliberately restricted to dense <=63-variable instances.
+class DualGate {
+public:
+    void invalidate() noexcept { ready_ = false; }
+
+    bool skips(const Clause& clause, const RowSpace& span) {
+        if (!ready_) {
+            rebuild(span);
+        }
+        auto signature = [&](const Equation& eqn) {
+            const std::uint64_t word = packed(eqn);
+            unsigned sig = 0;
+            for (std::size_t bit = 0; bit < count_; ++bit) {
+                sig |= (static_cast<unsigned>(std::popcount(word & masks_[bit]) & 1u)
+                        << bit);
+            }
+            return sig;
+        };
+        const unsigned a = signature(clause.row(clause.watched0));
+        if (a == 0) {
+            return false;
+        }
+        const unsigned b = signature(clause.row(clause.watched1));
+        return b != 0 && a != b;
+    }
+
+private:
+    void rebuild(const RowSpace& span) {
+        auto& stats = dual_stats();
+        ++stats.rebuilds;
+        count_ = 0;
+        const IndexSet& pivots = span.pivot_col_idxs();
+        for (std::size_t col = 0; col < span.cols() && count_ < masks_.size(); ++col) {
+            if (!pivots.test(col)) {
+                masks_[count_++] = std::uint64_t{1} << col;
+            }
+        }
+        // Row-echelon rows are processed in decreasing pivot order, so a
+        // newly solved pivot never changes an already-processed higher row.
+        for (std::size_t idx = span.rows(); idx > 0; --idx) {
+            const Equation& row = span.row(idx - 1);
+            const auto pivot = row.leading_bit();
+            assert(pivot.has_value() && *pivot < 64);
+            const std::uint64_t word = packed(row);
+            for (std::size_t bit = 0; bit < count_; ++bit) {
+                if ((std::popcount(word & masks_[bit]) & 1u) != 0) {
+                    masks_[bit] ^= std::uint64_t{1} << *pivot;
+                }
+            }
+            ++stats.row_visits;
+        }
+        ready_ = true;
+    }
+
+    bool ready_ = false;
+    std::size_t count_ = 0;
+    std::array<std::uint64_t, 4> masks_{};
+};
