+// Sound but deliberately conservative sufficient condition: the leading
+// column of *every nonzero vector in a row-echelon span* must be a pivot.
+// Thus two watched equations with distinct non-pivot leading columns are
+// linearly independent MODULO the span (their sum also leads at a nonpivot).
+// Do not mistake the raw coordinates in non-pivot columns for a quotient
+// projection: pivot rows can have nonzero bits there!
+// Observation only: NEVER skip a call in WU-016.
+bool leading_free_proves_independent(const Clause& clause, const RowSpace& trail_span) {
+    if (clause.rows() < 2) {
+        return false;
+    }
+    const IndexSet& pivots = trail_span.pivot_col_idxs();
+    const auto a = clause.row(clause.watched0).leading_bit();
+    const auto b = clause.row(clause.watched1).leading_bit();
+    return a.has_value() && b.has_value() && *a != *b &&
+           !pivots.test(*a) && !pivots.test(*b);
+}
+
+struct QuotientSample {
+    bool independent;
+    bool sig2;
+    bool sig4;
+    bool sig8;
+    std::size_t quotient_dim;
+};
+
+// Exact (expensive) *observational oracle*; it is NOT an optimized solver
+// check. Echelon full reduction is a canonical quotient representative,
+// unlike the unsound raw nonpivot projection rejected in WU-016.
+QuotientSample quotient_sample(const Clause& clause, const RowSpace& trail_span) {
+    Equation a = clause.row(clause.watched0);
+    Equation b = clause.row(clause.watched1);
+    trail_span.reduce(a);
+    trail_span.reduce(b);
+    const bool exact = !a.is_eq_true() && !b.is_eq_true() && !(a == b);
+
+    std::uint64_t sig_a = 0;
+    std::uint64_t sig_b = 0;
+    std::size_t free_count = 0;
+    const IndexSet& pivots = trail_span.pivot_col_idxs();
+    const auto& row_a = gf2_vector_of<DenseGF2Vector>(a);
+    const auto& row_b = gf2_vector_of<DenseGF2Vector>(b);
+    for (std::size_t bit = 0; bit < trail_span.cols(); ++bit) {
+        if (pivots.test(bit)) {
+            continue;
+        }
+        if (free_count < 8) {
+            sig_a |= static_cast<std::uint64_t>(row_a.get_bit(bit)) << free_count;
+            sig_b |= static_cast<std::uint64_t>(row_b.get_bit(bit)) << free_count;
+        }
+        ++free_count;
+    }
+    const auto independent_from_prefix = [sig_a, sig_b](std::size_t k) {
+        const std::uint64_t mask = (std::uint64_t{1} << k) - 1;
+        const std::uint64_t x = sig_a & mask;
+        const std::uint64_t y = sig_b & mask;
+        return x != 0 && y != 0 && x != y;
+    };
+    return {exact, independent_from_prefix(2), independent_from_prefix(4),
+            independent_from_prefix(8), free_count};
+}
