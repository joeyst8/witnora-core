+// Sound but deliberately conservative sufficient condition: the leading
+// column of *every nonzero vector in a row-echelon span* must be a pivot.
+// Thus two watched equations with distinct non-pivot leading columns are
+// linearly independent MODULO the span (their sum also leads at a nonpivot).
+// Do not mistake the raw coordinates in non-pivot columns for a quotient
+// projection: pivot rows can have nonzero bits there!
+// Observation only: NEVER skip a call in WU-016.
+bool leading_free_proves_independent(const Clause& clause, const RowSpace& trail_span) {
+    if (clause.rows() < 2) {
+        return false;
+    }
+    const IndexSet& pivots = trail_span.pivot_col_idxs();
+    const auto a = clause.row(clause.watched0).leading_bit();
+    const auto b = clause.row(clause.watched1).leading_bit();
+    return a.has_value() && b.has_value() && *a != *b &&
+           !pivots.test(*a) && !pivots.test(*b);
+}
